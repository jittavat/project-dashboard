# Copy this file to .env and fill in real values

# PostgreSQL
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=project_dashboard

# Backend — local dev: localhost; Docker Compose: postgres (the service name)
# DATABASE_URL format: postgres://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgres://dashboard:changeme@localhost:5432/project_dashboard
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

# Frontend (Vite build-time)
VITE_API_BASE_URL=http://localhost:8080/api/v1
